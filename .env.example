# ---------------------------------------------------------------------------
# Supabase : Project Settings > API
# (l'intégration Supabase de Vercel pose ces variables automatiquement)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique : l'un ou l'autre nom est accepté
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL publique de l'app, utilisée dans les liens envoyés par email.
# En local : http://localhost:3000. Sur Vercel : votre domaine de production
# (facultatif, le domaine de production Vercel est utilisé par défaut ;
# les déploiements de prévisualisation utilisent toujours leur propre URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed de démonstration uniquement : NE PAS ajouter à Vercel
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_EMAIL=demo@ai-nvoices.local
SEED_USER_PASSWORD=demo1234
